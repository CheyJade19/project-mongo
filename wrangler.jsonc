{
  // Cloudflare Worker that serves the app, its API, and receives forwarded email.
  "name": "household-calendar",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    // After `npx wrangler d1 create household-calendar`, paste the database_id it prints here.
    { "binding": "DB", "database_name": "household-calendar", "database_id": "REPLACE_WITH_DATABASE_ID" }
  ],
  "vars": {
    // The domain whose Email Routing catch-all sends mail to this Worker, e.g. "inbox.yourfamily.com".
    // Leave empty until you have one: forwarding addresses stay hidden and everything else works.
    "EMAIL_DOMAIN": "",
    // Sign in with Google: OAuth client ids, comma separated, web client first, then iOS and Android.
    "GOOGLE_CLIENT_IDS": "",
    // Sign in with Apple: the Services ID (web) and the app's bundle id, comma separated.
    "APPLE_CLIENT_IDS": "",
    // Who sign-in codes come from. The Resend API key is a secret: `npx wrangler secret put RESEND_API_KEY`.
    "MAIL_FROM": ""
  },
  // Keeps one device from hammering sign-in or the API. Limits are per key, per 60 seconds.
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ]
}
